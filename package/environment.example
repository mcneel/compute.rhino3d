# Rhino Compute Environment Configuration
# Copy this file to /etc/rhino-compute/environment and set your values
# After making changes, restart the service: sudo systemctl restart rhino-compute

# Required: Your Rhino API key for authentication
# Replace YOUR_API_KEY_HERE with your actual key
RHINO_TOKEN=YOUR_API_KEY_HERE

# Required: Create a doc while in headless mode
RHINO_COMPUTE_CREATE_HEADLESS_DOC=true

# Optional: Additional environment variables
# Uncomment and set as needed:
# RHINO_COMPUTE_LOAD_GRASSHOPPER=true
# RHINO_COMPUTE_MAX_REQUEST_SIZE=52428800
# RHINO_COMPUTE_TIMEOUT=100

# Optional: Write out logs
RHINO_COMPUTE_LOG_PATH=/var/log/rhino-compute
# RHINO_COMPUTE_LOG_RETAIN_DAYS=30

# Optional: Enable or disable analytics (default: true)
# Edit the /etc/profile.d/rhino3d_env.sh to set the 
# RHINO_ANALYTICS_ENABLED environment varible to 
# true or false.
# If you make changes to this file, please make sure to 
# stop and start Rhino.Compute for the changes to take effect.
# sudo nano /etc/profile.d/rhino3d_env.sh

