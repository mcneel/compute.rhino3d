#!/bin/sh

# This is a pre-removal script. 
# It runs before the rhino-compute package files are removed via apt-get remove

set -e

case "$1" in
    remove)
        # Stop and disable the service if systemd is available
        if [ -d /run/systemd/system ]; then
            # Stop the service if running
            if systemctl is-active --quiet rhino-compute; then
                systemctl stop rhino-compute
            fi

            # Disable the service if enabled
            if systemctl is-enabled --quiet rhino-compute; then
                systemctl disable rhino-compute
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
