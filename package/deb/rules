#!/usr/bin/make -f
export DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)

%:
	dh $@

override_dh_auto_configure:
	# nothing to configure

override_dh_auto_build:
	# nothing to build

override_dh_auto_install:
	# Copy prebuilt binaries into package staging dir
	echo "Building for architecture: $(DEB_HOST_ARCH)"
	mkdir -p debian/rhino-compute/usr/lib/rhino-compute/
	cp -r linux-$(DEB_HOST_ARCH)/build/rhino.compute debian/rhino-compute/usr/lib/rhino-compute/
	cp -r linux-$(DEB_HOST_ARCH)/build/compute.geometry debian/rhino-compute/usr/lib/rhino-compute/

	# Install wrapper into /usr/bin
	mkdir -p debian/rhino-compute/usr/bin
	echo '#!/bin/sh' > debian/rhino-compute/usr/bin/rhino-compute
	echo 'exec /usr/lib/rhino-compute/rhino.compute/rhino.compute "$$@"' >> debian/rhino-compute/usr/bin/rhino-compute
	chmod +x debian/rhino-compute/usr/bin/rhino-compute

	# Install startup script for non-systemd environments
	cp linux-$(DEB_HOST_ARCH)/build/rhino-compute-start.sh debian/rhino-compute/usr/bin/rhino-compute-start
	chmod +x debian/rhino-compute/usr/bin/rhino-compute-start

	# Install systemd service file
	mkdir -p debian/rhino-compute/lib/systemd/system
	cp linux-$(DEB_HOST_ARCH)/build/rhino-compute.service debian/rhino-compute/lib/systemd/system/

	# Install environment example file to /etc
	mkdir -p debian/rhino-compute/etc/rhino-compute
	cp linux-$(DEB_HOST_ARCH)/build/environment.example debian/rhino-compute/etc/rhino-compute/environment.example

	# Create log directory (ownership set in postinst after user creation)
	mkdir -p debian/rhino-compute/var/log/rhino-compute

override_dh_makeshlibs:
	# Skip makeshlibs for self-contained .NET binaries
	echo "Skipping dh_makeshlibs for self-contained binaries"

override_dh_shlibdeps:
	# Skip dependency analysis for self-contained .NET binaries
	echo "Skipping dh_shlibdeps for self-contained binaries"

override_dh_strip:
	# Skip stripping for self-contained .NET binaries
	echo "Skipping dh_strip for self-contained binaries"

override_dh_installsystemd:
	# Install systemd service but don't auto-start or auto-enable
	# User must manually configure and start the service
	dh_installsystemd --no-start --no-enable
