{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Hops",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build Hops",
            "program": "/Applications/RhinoWIP.app/Contents/MacOS/Rhinoceros",
            "args": [],
            "env": {
                "GRASSHOPPER_PLUGINS": "${workspaceFolder}/src/hops/bin/Debug/Hops.gha"
            },
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "Launch Hops (v7.17)",
            "type": "rhino",
            "request": "launch",
            "preLaunchTask": "Build Hops",
            "program": "/Applications/Rhino 7.17.app/Contents/MacOS/Rhinoceros",
            "args": [],
            "env": {
                "GRASSHOPPER_PLUGINS": "${workspaceFolder}/src/hops/bin/Debug/Hops.gha"
            },
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "Launch Hops (v7)",
            "type": "rhino",
            "request": "launch",
            "preLaunchTask": "Build Hops",
            "program": "/Applications/Rhino 7.app/Contents/MacOS/Rhinoceros",
            "args": [],
            "env": {
                "GRASSHOPPER_PLUGINS": "${workspaceFolder}/src/hops/bin/Debug/Hops.gha"
            },
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "Launch compute.geometry",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build compute.geometry",
            "justMyCode": false,
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "windows": {
                "program": "${workspaceFolder}/src/bin/Debug/compute.geometry/compute.geometry.exe"
            },
            "linux": {
                "program": "${workspaceFolder}/src/bin/Debug/compute.geometry/compute.geometry",
                "env": {
                    "RHINO_COMPUTE_CREATE_HEADLESS_DOC": "true"
                }
            }
        },
        {
            "name": "Launch rhino.compute",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build rhino.compute",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "windows": {
                "program": "${workspaceFolder}/src/bin/Debug/rhino.compute/rhino.compute.exe",
                "args": []
            },
            "linux": {
                "program": "${workspaceFolder}/src/bin/Debug/rhino.compute/rhino.compute",
                "args": ["--urls", "http://0.0.0.0:5000", "--create-headless-doc", "true"]
            }
        }
    ],
    "compounds": []
}